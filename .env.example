ANTHROPIC_API_KEY=sk-ant-...

# Only needed behind a proxy or gateway (e.g. a course-issued endpoint).
# Leave unset to talk to the Anthropic API directly.
# ANTHROPIC_BASE_URL=https://claude.vocareum.com

# Optional overrides
COSMIC_MART_MODEL=claude-opus-5
COSMIC_MART_SEED=42
# Reasoning effort per agent call: low | medium | high | xhigh | max
COSMIC_MART_EFFORT=medium
# Set to 1 to run every agent deterministically with no API calls.
COSMIC_MART_OFFLINE=0
